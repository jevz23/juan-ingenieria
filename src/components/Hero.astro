---
import { hero, profile } from "../data/content";
---

<section class="relative grid-bg overflow-hidden">
  <div class="max-w-7xl mx-auto px-6 lg:px-12 pt-12 lg:pt-20 pb-24 lg:pb-40">
    <div class="grid lg:grid-cols-12 gap-8 lg:gap-12 items-center">
      <!-- Columna izquierda: texto -->
      <div class="lg:col-span-7 fade-up">
        <p class="eyebrow mb-8">{hero.eyebrow}</p>

        <h1 class="font-display text-4xl sm:text-5xl lg:text-6xl xl:text-7xl leading-[1.02] tracking-tight text-ink-900 mb-10 max-w-4xl">
          {hero.titulo}
        </h1>

        <p class="text-base lg:text-lg text-ink-600 max-w-2xl leading-relaxed mb-12 text-justify">
          <Fragment set:html={hero.descripcion} />
        </p>

        <div class="flex flex-wrap items-center gap-4">
          <a
            href={hero.ctaPrimario.href}
            class="inline-flex items-center gap-3 bg-ink-900 text-ink-50 px-7 py-4 text-sm font-medium hover:bg-accent-600 transition-colors group"
          >
            {hero.ctaPrimario.texto}
            <svg width="14" height="14" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="1.5" class="group-hover:translate-x-1 transition-transform">
              <path d="M3 7h8M7 3l4 4-4 4" />
            </svg>
          </a>
          <a
            href={hero.ctaSecundario.href}
            class="inline-flex items-center gap-2 text-sm font-medium text-ink-700 px-2 py-4 border-b border-ink-400 hover:text-accent-600 hover:border-accent-600 transition-colors"
          >
            {hero.ctaSecundario.texto}
          </a>
        </div>
      </div>

<!-- Columna derecha: matriz 2x2 de esquemas técnicos -->
      <div class="lg:col-span-5 hidden lg:block fade-up" style="animation-delay: 0.3s">
        <div class="grid grid-cols-2 gap-2">

          <!-- Figura 1: TK proceso cono inox -->
          <div class="aspect-square bg-ink-50 border border-ink-200/60">
            <svg viewBox="0 0 320 320" fill="none" xmlns="http://www.w3.org/2000/svg" class="w-full h-full">
              <defs>
                <pattern id="tg-a" width="20" height="20" patternUnits="userSpaceOnUse">
                  <path d="M 20 0 L 0 0 0 20" fill="none" stroke="#C9C2B2" stroke-width="0.3"/>
                </pattern>
              </defs>
              <rect width="320" height="320" fill="url(#tg-a)" opacity="0.5"/>
              <g stroke="#14130F" stroke-width="1.2" fill="none">
                <line x1="105" y1="55" x2="215" y2="55" stroke-width="1.5"/>
                <line x1="105" y1="55" x2="105" y2="180" />
                <line x1="215" y1="55" x2="215" y2="180" />
                <line x1="160" y1="40" x2="160" y2="285" stroke-dasharray="4 4" stroke-width="0.6"/>
                <rect x="150" y="47" width="20" height="8" />
                <line x1="145" y1="47" x2="175" y2="47" stroke-width="1.5"/>
                <g stroke-width="1">
                  <path d="M 105 70 Q 100 72 105 74" />
                  <path d="M 215 70 Q 220 72 215 74" />
                  <path d="M 105 84 Q 100 86 105 88" />
                  <path d="M 215 84 Q 220 86 215 88" />
                  <path d="M 105 98 Q 100 100 105 102" />
                  <path d="M 215 98 Q 220 100 215 102" />
                  <path d="M 105 112 Q 100 114 105 116" />
                  <path d="M 215 112 Q 220 114 215 116" />
                  <path d="M 105 126 Q 100 128 105 130" />
                  <path d="M 215 126 Q 220 128 215 130" />
                  <path d="M 105 140 Q 100 142 105 144" />
                  <path d="M 215 140 Q 220 142 215 144" />
                  <path d="M 105 154 Q 100 156 105 158" />
                  <path d="M 215 154 Q 220 156 215 158" />
                  <path d="M 105 168 Q 100 170 105 172" />
                  <path d="M 215 168 Q 220 170 215 172" />
                </g>
                <rect x="215" y="145" width="20" height="14" />
                <line x1="235" y1="145" x2="235" y2="159" stroke-width="0.8" />
                <path d="M 235 152 Q 240 152 240 155" stroke-width="0.6" />
                <line x1="105" y1="180" x2="160" y2="238" />
                <line x1="215" y1="180" x2="160" y2="238" />
                <rect x="156" y="238" width="8" height="10" />
                <line x1="152" y1="248" x2="168" y2="248" stroke-width="1.2" />
                <path d="M 85 180 L 105 180 L 100 275 L 90 275 Z" />
                <path d="M 215 180 L 235 180 L 230 275 L 220 275 Z" />
                <rect x="83" y="275" width="24" height="4" />
                <rect x="213" y="275" width="24" height="4" />
                <line x1="20" y1="282" x2="300" y2="282" stroke-width="1.5" />
                <line x1="20" y1="287" x2="300" y2="292" stroke-width="0.4" stroke-dasharray="2 3" />
              </g>
              <g stroke="#C97F1A" stroke-width="0.6" fill="none">
                <line x1="255" y1="55" x2="255" y2="238" />
                <line x1="251" y1="55" x2="259" y2="55" />
                <line x1="251" y1="238" x2="259" y2="238" />
              </g>
              <g font-family="IBM Plex Mono, monospace" font-size="9" fill="#6E685B">
                <text x="267" y="150">H</text>
                <text x="240" y="153">M</text>
                <text x="160" y="308" text-anchor="middle" fill="#C97F1A">TK PROCESO CONO INOX</text>
              </g>
            </svg>
          </div>

          <!-- Figura 2: Chimenea con helicoides -->
          <div class="aspect-square bg-ink-50 border border-ink-200/60">
            <svg viewBox="0 0 320 320" fill="none" xmlns="http://www.w3.org/2000/svg" class="w-full h-full">
              <defs>
                <pattern id="tg-b" width="20" height="20" patternUnits="userSpaceOnUse">
                  <path d="M 20 0 L 0 0 0 20" fill="none" stroke="#C9C2B2" stroke-width="0.3"/>
                </pattern>
              </defs>
              <rect width="320" height="320" fill="url(#tg-b)" opacity="0.5"/>
              <g stroke="#14130F" stroke-width="1.2" fill="none">
                <line x1="145" y1="40" x2="145" y2="265" />
                <line x1="175" y1="40" x2="175" y2="265" />
                <line x1="145" y1="40" x2="175" y2="40" stroke-width="1.5"/>
                <line x1="160" y1="20" x2="160" y2="290" stroke-dasharray="4 4" stroke-width="0.6"/>
                <line x1="145" y1="55" x2="175" y2="65" />
                <line x1="145" y1="70" x2="175" y2="80" />
                <line x1="145" y1="85" x2="175" y2="95" />
                <line x1="145" y1="100" x2="175" y2="110" />
                <line x1="145" y1="115" x2="175" y2="125" />
                <path d="M 145 55 L 133 60 L 145 65 Z" />
                <path d="M 145 85 L 133 90 L 145 95 Z" />
                <path d="M 145 115 L 133 120 L 145 125 Z" />
                <path d="M 175 65 L 187 70 L 175 75 Z" />
                <path d="M 175 95 L 187 100 L 175 105 Z" />
                <path d="M 175 125 L 187 130 L 175 135 Z" />
                <line x1="180" y1="170" x2="190" y2="170" stroke-width="0.6" />
                <line x1="180" y1="190" x2="190" y2="190" stroke-width="0.6" />
                <line x1="180" y1="210" x2="190" y2="210" stroke-width="0.6" />
                <line x1="180" y1="230" x2="190" y2="230" stroke-width="0.6" />
                <line x1="190" y1="165" x2="190" y2="235" stroke-width="0.6" />
                <rect x="125" y="265" width="70" height="6" />
                <line x1="132" y1="271" x2="132" y2="278" stroke-width="1.2"/>
                <line x1="152" y1="271" x2="152" y2="278" stroke-width="1.2"/>
                <line x1="168" y1="271" x2="168" y2="278" stroke-width="1.2"/>
                <line x1="188" y1="271" x2="188" y2="278" stroke-width="1.2"/>
                <line x1="20" y1="278" x2="300" y2="278" stroke-width="1.5" />
                <line x1="20" y1="283" x2="300" y2="288" stroke-width="0.4" stroke-dasharray="2 3" />
              </g>
              <g stroke="#C97F1A" stroke-width="0.6" fill="none">
                <line x1="220" y1="40" x2="220" y2="265" />
                <line x1="216" y1="40" x2="224" y2="40" />
                <line x1="216" y1="265" x2="224" y2="265" />
                <line x1="200" y1="55" x2="200" y2="125" />
                <line x1="196" y1="55" x2="204" y2="55" />
                <line x1="196" y1="125" x2="204" y2="125" />
              </g>
              <g font-family="IBM Plex Mono, monospace" font-size="9" fill="#6E685B">
                <text x="232" y="153">H</text>
                <text x="212" y="93">Lh</text>
                <text x="160" y="308" text-anchor="middle" fill="#C97F1A">CHIMENEA · ASME STS-1</text>
              </g>
            </svg>
          </div>

          <!-- Figura 3: Estanque API 650 -->
          <div class="aspect-square bg-ink-50 border border-ink-200/60">
            <svg viewBox="0 0 320 320" fill="none" xmlns="http://www.w3.org/2000/svg" class="w-full h-full">
              <defs>
                <pattern id="tg-c" width="20" height="20" patternUnits="userSpaceOnUse">
                  <path d="M 20 0 L 0 0 0 20" fill="none" stroke="#C9C2B2" stroke-width="0.3"/>
                </pattern>
                <pattern id="hatch-c" patternUnits="userSpaceOnUse" width="6" height="6" patternTransform="rotate(45)">
                  <line x1="0" y1="0" x2="0" y2="6" stroke="#C97F1A" stroke-width="0.8"/>
                </pattern>
              </defs>
              <rect width="320" height="320" fill="url(#tg-c)" opacity="0.5"/>
              <g stroke="#14130F" stroke-width="1.2" fill="none">
                <path d="M 55 105 L 160 65 L 265 105" />
                <line x1="55" y1="105" x2="55" y2="255" />
                <line x1="265" y1="105" x2="265" y2="255" />
                <line x1="50" y1="255" x2="270" y2="255" stroke-width="1.5" />
                <line x1="160" y1="50" x2="160" y2="275" stroke-dasharray="4 4" stroke-width="0.6"/>
                <path d="M 55 105 L 160 65 L 265 105 L 263 108 L 160 68 L 57 108 Z" fill="url(#hatch-c)"/>
                <rect x="155" y="60" width="10" height="8" />
                <line x1="150" y1="60" x2="170" y2="60" stroke-width="1.5"/>
                <rect x="35" y="215" width="20" height="18" />
                <line x1="30" y1="215" x2="30" y2="233" stroke-width="1"/>
                <rect x="35" y="175" width="20" height="10" />
                <rect x="105" y="82" width="10" height="8" />
                <line x1="100" y1="82" x2="120" y2="82" stroke-width="1.5"/>
                <line x1="272" y1="115" x2="272" y2="250" stroke-width="0.6" />
                <line x1="285" y1="115" x2="285" y2="250" stroke-width="0.6" />
                <line x1="272" y1="130" x2="285" y2="130" stroke-width="0.6" />
                <line x1="272" y1="150" x2="285" y2="150" stroke-width="0.6" />
                <line x1="272" y1="170" x2="285" y2="170" stroke-width="0.6" />
                <line x1="272" y1="190" x2="285" y2="190" stroke-width="0.6" />
                <line x1="272" y1="210" x2="285" y2="210" stroke-width="0.6" />
                <line x1="272" y1="230" x2="285" y2="230" stroke-width="0.6" />
                <line x1="272" y1="250" x2="285" y2="250" stroke-width="0.6" />
                <rect x="45" y="255" width="230" height="5" />
                <line x1="20" y1="262" x2="300" y2="262" stroke-width="1.5" />
                <line x1="20" y1="267" x2="300" y2="272" stroke-width="0.4" stroke-dasharray="2 3" />
              </g>
              <g stroke="#C97F1A" stroke-width="0.6" fill="none">
                <line x1="55" y1="285" x2="265" y2="285" />
                <line x1="55" y1="281" x2="55" y2="289" />
                <line x1="265" y1="281" x2="265" y2="289" />
              </g>
              <g font-family="IBM Plex Mono, monospace" font-size="9" fill="#6E685B">
                <text x="160" y="298" text-anchor="middle">D</text>
                <text x="30" y="207" text-anchor="end">M</text>
                <text x="160" y="315" text-anchor="middle" fill="#C97F1A">API 650 · TK ATMOSFERICO</text>
              </g>
            </svg>
          </div>

          <!-- Figura 4: Correa transportadora -->
          <div class="aspect-square bg-ink-50 border border-ink-200/60">
            <svg viewBox="0 0 320 320" fill="none" xmlns="http://www.w3.org/2000/svg" class="w-full h-full">
              <defs>
                <pattern id="tg-d" width="20" height="20" patternUnits="userSpaceOnUse">
                  <path d="M 20 0 L 0 0 0 20" fill="none" stroke="#C9C2B2" stroke-width="0.3"/>
                </pattern>
              </defs>
              <rect width="320" height="320" fill="url(#tg-d)" opacity="0.5"/>
              <g stroke="#14130F" stroke-width="1.2" fill="none">
                <circle cx="60" cy="160" r="20" />
                <circle cx="60" cy="160" r="2" fill="#14130F"/>
                <circle cx="260" cy="160" r="24" />
                <circle cx="260" cy="160" r="2" fill="#14130F"/>
                <line x1="60" y1="140" x2="260" y2="136" />
                <line x1="60" y1="180" x2="260" y2="184" />
                <circle cx="95" cy="146" r="3" />
                <circle cx="130" cy="145" r="3" />
                <circle cx="165" cy="144" r="3" />
                <circle cx="200" cy="143" r="3" />
                <circle cx="235" cy="142" r="3" />
                <circle cx="115" cy="188" r="3" />
                <circle cx="175" cy="189" r="3" />
                <circle cx="235" cy="190" r="3" />
                <line x1="35" y1="75" x2="85" y2="75" stroke-width="1.5" />
                <line x1="35" y1="75" x2="35" y2="115" />
                <line x1="85" y1="75" x2="85" y2="115" />
                <line x1="35" y1="115" x2="55" y2="135" />
                <line x1="85" y1="115" x2="65" y2="135" />
                <path d="M 75 136 L 240 128" stroke-dasharray="1 2" stroke-width="0.8" />
                <path d="M 285 152 Q 290 180 293 215" stroke-dasharray="2 2" stroke-width="0.8" />
                <path d="M 290 152 Q 296 180 300 215" stroke-dasharray="2 2" stroke-width="0.8" />
              </g>
              <g stroke="#C97F1A" stroke-width="0.6" fill="none">
                <line x1="60" y1="240" x2="260" y2="240" />
                <line x1="60" y1="236" x2="60" y2="244" />
                <line x1="260" y1="236" x2="260" y2="244" />
              </g>
              <g font-family="IBM Plex Mono, monospace" font-size="9" fill="#6E685B">
                <text x="160" y="252" text-anchor="middle">Cc</text>
                <text x="60" y="207" text-anchor="middle">TP</text>
                <text x="260" y="202" text-anchor="middle">HP</text>
                <text x="60" y="65" text-anchor="middle">CHUTE</text>
                <text x="160" y="308" text-anchor="middle" fill="#C97F1A">CORREA · CEMA</text>
              </g>
            </svg>
          </div>

        </div>
      </div>

    <!-- Stats / credibilidad inferior -->
    <div class="mt-20 lg:mt-32 pt-10 border-t border-ink-200 grid grid-cols-2 md:grid-cols-4 gap-8">
      <div>
        <p class="font-mono text-xs text-ink-500 mb-2">// Normativas</p>
        <p class="font-display text-2xl text-ink-900">ASME · AISC · API</p>
      </div>
      <div>
        <p class="font-mono text-xs text-ink-500 mb-2">// Herramientas</p>
        <p class="font-display text-2xl text-ink-900">SAP2000 · MathCAD</p>
      </div>
      <div>
        <p class="font-mono text-xs text-ink-500 mb-2">// Sectores</p>
        <p class="font-display text-2xl text-ink-900">Minería · Industria</p>
      </div>
      <div>
        <p class="font-mono text-xs text-ink-500 mb-2">// Ubicación</p>
        <p class="font-display text-2xl text-ink-900">{profile.ubicacion}</p>
      </div>
    </div>
  </div>
</section>
