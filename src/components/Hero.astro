---
import { hero, profile } from "../data/content";
---

<section class="relative grid-bg overflow-hidden">
  <div class="max-w-7xl mx-auto px-6 lg:px-12 pt-20 lg:pt-32 pb-24 lg:pb-40">
    <div class="grid lg:grid-cols-12 gap-12 items-end">
      <!-- Columna izquierda: texto -->
      <div class="lg:col-span-8 fade-up">
        <p class="eyebrow mb-8">{hero.eyebrow}</p>

        <h1 class="font-display text-5xl sm:text-6xl lg:text-7xl xl:text-8xl leading-[1.02] tracking-tight text-ink-900 mb-10 max-w-4xl">
          {hero.titulo}
        </h1>

        <p class="text-lg lg:text-xl text-ink-600 max-w-2xl leading-relaxed mb-12">
          <Fragment set:html={hero.descripcion} />
        </p>

        <div class="flex flex-wrap items-center gap-4">
          <a
            href={hero.ctaPrimario.href}
            class="inline-flex items-center gap-3 bg-ink-900 text-ink-50 px-7 py-4 text-sm font-medium hover:bg-accent-600 transition-colors group"
          >
            {hero.ctaPrimario.texto}
            <svg width="14" height="14" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="1.5" class="group-hover:translate-x-1 transition-transform">
              <path d="M3 7h8M7 3l4 4-4 4" />
            </svg>
          </a>
          <a
            href={hero.ctaSecundario.href}
            class="inline-flex items-center gap-2 text-sm font-medium text-ink-700 px-2 py-4 border-b border-ink-400 hover:text-accent-600 hover:border-accent-600 transition-colors"
          >
            {hero.ctaSecundario.texto}
          </a>
        </div>
      </div>

      <!-- Columna derecha: SVG técnico decorativo -->
      <div class="lg:col-span-4 hidden lg:block fade-up" style="animation-delay: 0.3s">
        <div class="relative aspect-square">
          <!-- Diagrama técnico estilizado: recipiente a presión visto en corte -->
          <svg viewBox="0 0 320 320" fill="none" xmlns="http://www.w3.org/2000/svg" class="w-full h-full">
            <!-- Grid de fondo -->
            <defs>
              <pattern id="techgrid" width="20" height="20" patternUnits="userSpaceOnUse">
                <path d="M 20 0 L 0 0 0 20" fill="none" stroke="#C9C2B2" stroke-width="0.3"/>
              </pattern>
              <pattern id="hatch" patternUnits="userSpaceOnUse" width="6" height="6" patternTransform="rotate(45)">
                <line x1="0" y1="0" x2="0" y2="6" stroke="#C97F1A" stroke-width="0.8"/>
              </pattern>
            </defs>
            <rect width="320" height="320" fill="url(#techgrid)" opacity="0.5"/>

            <!-- Recipiente a presión vertical -->
            <g stroke="#14130F" stroke-width="1.2" fill="none">
              <!-- Cabezas elipsoidales -->
              <path d="M 100 90 Q 160 50 220 90" />
              <path d="M 100 230 Q 160 270 220 230" />
              <!-- Envolvente -->
              <line x1="100" y1="90" x2="100" y2="230" />
              <line x1="220" y1="90" x2="220" y2="230" />
              <!-- Línea de centro -->
              <line x1="160" y1="40" x2="160" y2="280" stroke-dasharray="4 4" stroke-width="0.6"/>
              <!-- Espesor de pared (hatch) -->
              <path d="M 100 90 Q 160 50 220 90 L 218 92 Q 160 54 102 92 Z" fill="url(#hatch)"/>
              <path d="M 100 230 Q 160 270 220 230 L 218 228 Q 160 266 102 228 Z" fill="url(#hatch)"/>
              <!-- Boquillas -->
              <rect x="155" y="35" width="10" height="20" />
              <line x1="150" y1="35" x2="170" y2="35" stroke-width="1.5"/>
              <rect x="155" y="265" width="10" height="20" />
              <line x1="150" y1="285" x2="170" y2="285" stroke-width="1.5"/>
              <!-- Soporte lateral -->
              <rect x="80" y="150" width="20" height="6" />
              <rect x="220" y="150" width="20" height="6" />
            </g>

            <!-- Cotas -->
            <g stroke="#C97F1A" stroke-width="0.6" fill="none">
              <line x1="250" y1="90" x2="250" y2="230" />
              <line x1="246" y1="90" x2="254" y2="90" />
              <line x1="246" y1="230" x2="254" y2="230" />
            </g>

            <!-- Labels -->
            <g font-family="IBM Plex Mono, monospace" font-size="9" fill="#6E685B">
              <text x="262" y="163">H</text>
              <text x="92" y="80" text-anchor="end">N1</text>
              <text x="92" y="244" text-anchor="end">N2</text>
              <text x="160" y="305" text-anchor="middle" fill="#C97F1A">ASME VIII · DIV. 1</text>
            </g>
          </svg>
        </div>
      </div>
    </div>

    <!-- Stats / credibilidad inferior -->
    <div class="mt-20 lg:mt-32 pt-10 border-t border-ink-200 grid grid-cols-2 md:grid-cols-4 gap-8">
      <div>
        <p class="font-mono text-xs text-ink-500 mb-2">// Normativas</p>
        <p class="font-display text-2xl text-ink-900">ASME · AISC · API</p>
      </div>
      <div>
        <p class="font-mono text-xs text-ink-500 mb-2">// Herramientas</p>
        <p class="font-display text-2xl text-ink-900">SAP2000 · MathCAD</p>
      </div>
      <div>
        <p class="font-mono text-xs text-ink-500 mb-2">// Sectores</p>
        <p class="font-display text-2xl text-ink-900">Minería · Industria</p>
      </div>
      <div>
        <p class="font-mono text-xs text-ink-500 mb-2">// Ubicación</p>
        <p class="font-display text-2xl text-ink-900">{profile.ubicacion}</p>
      </div>
    </div>
  </div>
</section>
