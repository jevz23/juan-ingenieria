---
import { sobre, profile } from "../data/content";
---

<section id="sobre" class="bg-ink-50 pt-16 lg:pt-24 pb-16 lg:pb-24">
  <div class="max-w-7xl mx-auto px-6 lg:px-12">
    <div class="grid lg:grid-cols-12 gap-12 lg:gap-20 text-justify">
      <!-- Columna izquierda: avatar/foto + nombre -->
      <div class="lg:col-span-5">
        <div class="sticky top-32">
          <p class="eyebrow mb-6">§ 03 / Sobre el servicio</p>

          <!-- Logo JVI expandido -->
          <div class="relative aspect-[4/5] bg-ink-100 mb-8 max-w-sm overflow-hidden flex items-center justify-center">
            <div class="absolute inset-0 grid-bg"></div>
            <svg viewBox="0 0 260 140" class="w-4/5 h-auto relative z-10" xmlns="http://www.w3.org/2000/svg">
              <text x="130" y="60" text-anchor="middle" font-family="IBM Plex Sans, system-ui, sans-serif" font-size="52" font-weight="600" fill="#14130F" letter-spacing="3">JVI</text>
              <line x1="55" y1="80" x2="205" y2="80" stroke="#C97F1A" stroke-width="1.2" />
              <text x="130" y="105" text-anchor="middle" font-family="IBM Plex Sans, system-ui, sans-serif" font-size="13" fill="#6E685B" letter-spacing="6" font-weight="500">SERVICIOS TÉCNICOS</text>
            </svg>
          </div>
          <p class="font-display text-2xl text-ink-900 leading-tight">
            {profile.nombre}
          </p>
          <p class="font-mono text-sm text-ink-500 mt-1">
            {profile.titulo}
          </p>
        </div>
      </div>

      <!-- Columna derecha: bio y credenciales -->
      <div class="lg:col-span-7">
        <h2 class="font-display text-4xl lg:text-5xl tracking-tight text-ink-900 mb-10 leading-[1.1]">
          {sobre.titulo}
        </h2>

        <div class="space-y-6 text-ink-700 leading-relaxed text-lg max-w-2xl mb-12">
          {sobre.parrafos.map((p) => <p>{p}</p>)}
        </div>

        <div class="section-rule mb-10"></div>

        <p class="font-mono text-xs text-ink-500 mb-6 uppercase tracking-wider">
          // Credenciales
        </p>
        <ul class="space-y-4">
          {
            sobre.credenciales.map((c) => (
              <li class="flex items-start gap-4 text-ink-800">
                <span class="font-mono text-xs text-accent-600 mt-1.5">→</span>
                <span>{c}</span>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </div>
</section>
