---
import { proyectos } from "../data/content";
---

<section id="experiencia" class="bg-ink-100 pt-16 lg:pt-20 pb-12 lg:pb-16">
  <div class="max-w-7xl mx-auto px-6 lg:px-12">
    <!-- Section header -->
    <div class="mb-16 lg:mb-20 max-w-3xl">
      <p class="eyebrow mb-6">§ 04 / Experiencia</p>
      <h2 class="font-display text-4xl lg:text-5xl tracking-tight text-ink-900 mb-6">
        Proyectos representativos
      </h2>
      <p class="text-ink-600 mt-6 max-w-2xl leading-relaxed">
        Selección anonimizada de trabajos recientes. Detalles bajo acuerdo de confidencialidad.
      </p>
      <div class="section-rule mt-10"></div>
    </div>

    <!-- Timeline -->
    <div class="space-y-px bg-ink-200">
      {
        proyectos.map((p) => (
          <article class="bg-ink-100 hover:bg-ink-50 transition-colors pt-4 lg:pt-8 pb-4 lg:pb-8 px-2 lg:px-4 group">
            <div class="grid lg:grid-cols-12 gap-6 items-baseline">
              <div class="lg:col-span-2">
                <span class="font-mono text-sm text-accent-600">{p.año}</span>
              </div>
              <div class="lg:col-span-7">
                <h3 class="font-display text-2xl lg:text-3xl text-ink-900 mb-3 leading-tight">
                  {p.titulo}
                </h3>
                <p class="text-ink-600 leading-relaxed max-w-2xl">
                  {p.descripcion}
                </p>
              </div>
              <div class="lg:col-span-3 lg:text-right">
                <span class="font-mono text-xs text-ink-500 tracking-wider uppercase">
                  {p.tipo}
                </span>
              </div>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>
