---
import { profile } from "../data/content";

const asunto = encodeURIComponent("Solicitud de cotización — Servicios de ingeniería");
const cuerpo = encodeURIComponent(
  `Hola ${profile.nombre.split(" ")[0]},\n\nMe interesa solicitar una cotización para el siguiente trabajo:\n\n[Describe brevemente: tipo de servicio, alcance, fechas, ubicación]\n\nQuedo atento.\n\nSaludos.`
);
---

<section id="contacto" class="bg-ink-950 text-ink-50 pt-12 lg:pt-20 pb-12 lg:pb-20 relative overflow-hidden">
  <!-- Decoración: línea técnica -->
  <div class="absolute top-0 left-0 right-0 h-px bg-gradient-to-r from-transparent via-accent-500 to-transparent"></div>

  <div class="max-w-7xl mx-auto px-6 lg:px-12 relative">
    <div class="grid lg:grid-cols-12 gap-12 lg:gap-20">
      <!-- Columna izquierda: invitación -->
      <div class="lg:col-span-7">
        <p class="eyebrow mb-8" style="color: var(--color-accent-400);">§ 05 / Contacto</p>

        <h2 class="font-display text-5xl lg:text-6xl xl:text-7xl tracking-tight leading-[1.05] mb-10">
          ¿Tienes un proyecto?<br />
          <span class="text-ink-400">Conversemos.</span>
        </h2>

        <p class="text-ink-300 text-lg leading-relaxed max-w-xl mb-10">
          Cuéntame brevemente sobre tu necesidad — alcance, normativa aplicable
          y plazos — y te entrego una propuesta técnica y económica en menos de 48 horas.
        </p>

        <a
          href={`mailto:${profile.email}?subject=${asunto}&body=${cuerpo}`}
          class="inline-flex items-center gap-3 bg-accent-500 text-ink-950 px-8 py-5 text-sm font-medium hover:bg-accent-400 transition-colors group"
        >
          Escribir un correo
          <svg width="14" height="14" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="1.5" class="group-hover:translate-x-1 transition-transform">
            <path d="M3 7h8M7 3l4 4-4 4" />
          </svg>
        </a>
      </div>

      <!-- Columna derecha: detalles de contacto -->
      <div class="lg:col-span-5 lg:border-l lg:border-ink-800 lg:pl-12">
        <p class="font-mono text-xs text-ink-400 mb-8 uppercase tracking-wider">
          // Canales directos
        </p>

        <dl class="space-y-8">
          <div>
            <dt class="font-mono text-xs text-ink-500 mb-2 uppercase tracking-wider">
              Correo
            </dt>
            <dd>
              <a
                href={`mailto:${profile.email}`}
                class="font-display text-2xl text-ink-50 hover:text-accent-400 transition-colors break-all"
              >
                {profile.email}
              </a>
            </dd>
          </div>

          <div>
            <dt class="font-mono text-xs text-ink-500 mb-2 uppercase tracking-wider">
              Teléfono
            </dt>
            <dd>
              <a
                href={`tel:${profile.telefono.replace(/\s/g, "")}`}
                class="font-display text-2xl text-ink-50 hover:text-accent-400 transition-colors"
              >
                {profile.telefono}
              </a>
            </dd>
          </div>

          <div>
            <dt class="font-mono text-xs text-ink-500 mb-2 uppercase tracking-wider">
              Ubicación
            </dt>
            <dd class="font-display text-2xl text-ink-50">
              {profile.ubicacion}
            </dd>
          </div>

          <div>
            <dt class="font-mono text-xs text-ink-500 mb-2 uppercase tracking-wider">
              LinkedIn
            </dt>
            <dd>
              <a
                href={profile.linkedin}
                target="_blank"
                rel="noopener noreferrer"
                class="font-display text-2xl text-ink-50 hover:text-accent-400 transition-colors inline-flex items-center gap-2"
              >
                Perfil profesional
                <svg width="14" height="14" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="1.5">
                  <path d="M5 3h6v6M11 3l-8 8" />
                </svg>
              </a>
            </dd>
          </div>
        </dl>
      </div>
    </div>
  </div>
</section>
